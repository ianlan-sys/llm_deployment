# Safe offline mode (default). Change to real only after configuring and
# testing the OpenAI-compatible endpoint below.
DEMO_PROVIDER_MODE=demo

# Authentication is mandatory for the Compose deployment. Generate values with
# scripts/generate-demo-auth.ps1. Put only the username, password hash, and
# session secret here; the printed plaintext password is for the operator only.
DEMO_AUTH_REQUIRED=true
DEMO_AUTH_USERNAME=
DEMO_AUTH_PASSWORD_HASH=
DEMO_SESSION_SECRET=

# Real-provider settings. The API key is read by the backend only and is never
# included in frontend build arguments, browser storage, or API responses.
DEMO_OPENAI_BASE_URL=http://host.docker.internal:11434/v1
DEMO_OPENAI_MODEL=your-model-name
DEMO_OPENAI_API_KEY=

# Internal Ollama health settings. These are consumed by the backend only;
# the service remains on the Docker Compose network and is never exposed to browsers.
DEMO_OLLAMA_BASE_URL=http://ollama:11434
DEMO_OLLAMA_MODEL=qwen3:1.7b-q4_K_M
DEMO_OLLAMA_TIMEOUT_SECONDS=5

# Optional operational limits
DEMO_PROVIDER_TIMEOUT_SECONDS=30
DEMO_MAX_UPLOAD_BYTES=20971520
